---
import path from "node:path";
import "../styles/main.css";
import site from "../../data/site.json";
import Header from "../components/navigation/header.astro";
import Footer from "../components/navigation/footer.astro";
import { SEO } from "astro-seo";
import { localeCodes } from "../utils/locales";

export interface SEOProps {
  page_description: string | null;
  featured_image: string | null;
  featured_image_alt: string | null;
  canonical_url: string | null;
  no_index: boolean | null;
  open_graph_type: string | null;
  author_twitter_handle: string | null;
}

export interface Props {
  title: string;
  seo?: SEOProps;
  roseyRoot?: string;
  // Override the derived keys where one route serves many pages, so each needs
  // its own key (taxonomy titles) or one shared key (their descriptions).
  roseyTitleKey?: string;
  roseyDescriptionKey?: string;
  // Opt-in, not a default: split-by-directory pages must not have head keys —
  // their head comes from translated frontmatter, which a Rosey value overrides.
  roseySeo?: boolean;
  // Hide the RCC's locale switcher. For split-by-directory pages, where the body
  // is translated by editing the locale's own content file, so switching locale
  // in the Visual Editor would offer nothing to translate.
  hideLocaleSwitcher?: boolean;
}

const {
  seo,
  title,
  roseyRoot,
  roseyTitleKey,
  roseyDescriptionKey,
  roseySeo,
  hideLocaleSwitcher,
} = Astro.props;

// The RCC hides its switcher when every locale is excluded. Derived from the
// locale config so adding a language doesn't leave a locale switchable here.
const rccExclude = hideLocaleSwitcher ? localeCodes.join(",") : undefined;
const baseUrl = Astro.site?.toString() ?? "";

// Rosey namespace for this page. Split-by-directory locale pages pass the
// English-equivalent path via roseyRoot so their keys match the source page.
const derivedRoseyRoot = Astro.url.pathname.replace(/^\/|\/$/g, "") || "index";
const pageRoseyRoot = roseyRoot ?? derivedRoseyRoot;

// astro-seo renders <title>/<meta name="description"> with no way to attach
// data-rosey attributes, so where we have keys we suppress its versions and
// emit our own instead.
const titleKey =
  roseyTitleKey ?? (roseySeo ? `${pageRoseyRoot}:page_title` : undefined);
const descriptionKey =
  roseyDescriptionKey ??
  (roseySeo ? `${pageRoseyRoot}:page_description` : undefined);

let pageTitle = "";
if (!title) {
  pageTitle = site.site_title;
} else if (Astro.url.pathname === "/") {
  pageTitle = title;
} else {
  pageTitle = `${title} | ${site.site_title}`;
}

const description = seo?.page_description ?? site.description;
const image = seo?.featured_image ?? site.image;
const imagePath = path.join(baseUrl, image);
const imageAlt = seo?.featured_image_alt ?? site.image_alt;
const canonicalURL = new URL(seo?.canonical_url ?? Astro.url.pathname, baseUrl);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    {titleKey && <title data-rosey={titleKey}>{pageTitle}</title>}
    {
      descriptionKey && (
        <meta
          name="description"
          content={description}
          data-rosey-attrs-explicit={JSON.stringify({
            content: descriptionKey,
          })}
        />
      )
    }

    <SEO
      noindex={seo?.no_index || false}
      title={titleKey ? undefined : pageTitle}
      description={descriptionKey ? undefined : description}
      canonical={canonicalURL.toString()}
      openGraph={{
        basic: {
          title: pageTitle,
          url: baseUrl?.toString(),
          type: seo?.open_graph_type || "website",
          image: imagePath,
        },
        optional: { description },
        image: { url: imagePath, alt: imageAlt },
      }}
      twitter={{
        creator: `${seo?.author_twitter_handle || site.twitter_site}`,
        site: `${site.twitter_site}`,
        card: "summary_large_image",
      }}
    />
  </head>
  <body class="flex flex-col min-h-screen">
    <div data-rcc data-rcc-exclude={rccExclude} class="flex flex-col min-h-screen">
      <Header />
      <main class="flex-1" data-rosey-root={pageRoseyRoot}>
        <slot />
      </main>
      <Footer />
    </div>
    <script>
      if (window.inEditorMode) {
        import("../scripts/register-components.ts").catch((error) => {
          console.warn("Failed to load CloudCannon component registration:", error);
        });
        import("rosey-cloudcannon-connector");
      }
    </script>
  </body>
</html>
